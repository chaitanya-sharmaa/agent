      },
      "17": {
        "chunkId": "894720",
        "hash": "0f89ad2d",
        "encoded": "3.%20**Text%20vs%20Tool%20Calls**:%20The%20model%20outputs%20JSON%20text%20that%20looks%20like%20tool%20calls%20but%20aren't%20actual%20function%20invocations",
        "prevChunkIds": []
      },
